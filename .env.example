# ============================================================
#  Personal Voice AI Agent — Environment Variables
# ============================================================

# --- LLM (Required) -----------------------------------------
OPENAI_API_KEY=sk-...

# --- Speech-to-Text ------------------------------------------
# Option 1: OpenAI Whisper (uses OPENAI_API_KEY)
STT_PROVIDER=whisper          # whisper | deepgram

# Option 2: Deepgram (optional, uncomment to use)
# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=dg-...

# --- Text-to-Speech ------------------------------------------
# Option 1: OpenAI TTS (uses OPENAI_API_KEY)
TTS_PROVIDER=openai           # openai | elevenlabs
TTS_VOICE=alloy               # alloy | nova | shimmer | echo | fable | onyx

# Option 2: ElevenLabs (optional)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Web Search ----------------------------------------------
TAVILY_API_KEY=tvly-...       # Get free key at https://app.tavily.com

# --- Database ------------------------------------------------
DATABASE_URL=postgresql+asyncpg://voice_agent:secret@localhost:5432/voice_agent_db
POSTGRES_USER=voice_agent
POSTGRES_PASSWORD=secret
POSTGRES_DB=voice_agent_db

# --- Redis ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Vector Database (ChromaDB) ------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=voice_agent_memory

# --- JWT Auth ------------------------------------------------
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- Google OAuth (optional — for Gmail + Calendar) ----------
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Weather API (optional) ----------------------------------
# OPENWEATHER_API_KEY=...

# --- App Config ----------------------------------------------
ENVIRONMENT=development        # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- LangGraph -----------------------------------------------
LANGCHAIN_TRACING_V2=false     # Set true to enable LangSmith tracing
# LANGCHAIN_API_KEY=...
# LANGCHAIN_PROJECT=voice-agent
LLM_MODEL=gpt-4o               # gpt-4o | gpt-4o-mini | gpt-4-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
